{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ModelsRerankAndGuardrails",
      "Effect": "Allow",
      "Action": ["bedrock:InvokeModel", "bedrock:Converse", "bedrock:Rerank", "bedrock:ApplyGuardrail"],
      "Resource": [
        "arn:aws:bedrock:*::foundation-model/*",
        "arn:aws:bedrock:*:*:inference-profile/*",
        "arn:aws:bedrock:*:*:guardrail/*"
      ]
    }
  ]
}
